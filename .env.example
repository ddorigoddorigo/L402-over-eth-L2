# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# 8453 = Base mainnet, 84532 = Base Sepolia, 42161 = Arbitrum One, 10 = Optimism
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# L402Escrow contract (printed by `npm run deploy -w @l402-el2/contracts`)
ESCROW_ADDRESS=0x

# Payment token.
# Base mainnet cbBTC: 0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf (8 decimals)
# On testnets: deploy MockBTC and put its address here.
TOKEN_ADDRESS=0x
TOKEN_SYMBOL=cbBTC
TOKEN_DECIMALS=8

# ---------------------------------------------------------------------------
# MCP server (the provider that gets paid)
# ---------------------------------------------------------------------------
SERVICE_NAME=mcp.example.com
PORT=3402

# Wallet that receives the payments. In production keep it in a KMS/HSM.
PROVIDER_PRIVATE_KEY=0x

# HMAC key for macaroons: 32 bytes in hex.
#   openssl rand -hex 32
# Rotating it invalidates every macaroon issued so far.
MACAROON_ROOT_KEY=

# Voucher store. Without Redis the memory store is used: development only
# (vouchers are lost on restart, it does not work with several instances, and
# the settler — a separate process — cannot see them).
REDIS_URL=
REDIS_PREFIX=l402

# ---------------------------------------------------------------------------
# Settler (periodic collection)
# ---------------------------------------------------------------------------
# Minimum amount worth settling, in token base units. 10000 sat ≈ 0.0001 BTC:
# far above the L2 gas cost, so a settlement never loses money.
MIN_SETTLE_AMOUNT=10000
SETTLE_BATCH_SIZE=50
SETTLE_INTERVAL_MS=3600000
# Vouchers whose settlement deadline (voucher/channel/session-key expiry) is
# closer than this many seconds are settled regardless of MIN_SETTLE_AMOUNT.
# Keep it larger than SETTLE_INTERVAL_MS / 1000.
SETTLE_EXPIRY_BUFFER=5400

# ---------------------------------------------------------------------------
# AI agent (the payer)
# ---------------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:3402

# Owner key of the smart account (or of the EOA if you do not use ERC-4337).
AGENT_PRIVATE_KEY=0x

# ERC-4337 bundler (Pimlico, Alchemy, Coinbase...). If empty, the agent uses an EOA.
BUNDLER_URL=

# Agent spending limits, in human-readable token units.
DAILY_CAP=0.0005
MAX_PRICE_PER_CALL=0.0001

# ---------------------------------------------------------------------------
# Contract deployment
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=0x
# Empty / 0x = use the deployer address.
ESCROW_OWNER=0x
# Empty / 0x = use the owner address.
FEE_RECIPIENT=0x
PROTOCOL_FEE_BPS=0
CHAIN=base-sepolia
BASESCAN_API_KEY=
