{
  "name": "l402-el2",
  "version": "0.1.0",
  "private": true,
  "description": "L402 over Ethereum Layer 2 — wrapped-BTC payments for MCP servers through EIP-712 payment channels",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/core packages/server packages/client packages/settler",
    "test": "npm run test --workspaces --if-present",
    "compile:contracts": "npm run compile -w @l402-el2/contracts",
    "test:contracts": "npm run test -w @l402-el2/contracts",
    "example:server": "tsx examples/server.ts",
    "example:agent": "tsx examples/agent.ts",
    "example:e2e": "tsx examples/e2e.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
